/* Qt translation of the JavaFX IFCtoLBD_Desktop_2026 app.css */

QMainWindow, QWidget#topRegion {
    background-color: #dbeafe;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #172033;
}

QMenuBar {
    background-color: rgba(255, 255, 255, 240);
    border-bottom: 1px solid #cfd8e6;
}

QMenuBar::item:selected {
    background-color: #eef5ff;
    border-radius: 6px;
}

QMenu {
    background-color: white;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 18px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #eef5ff;
    color: #1e3a5f;
}

QLabel#appTitle {
    font-size: 20px;
    font-weight: 800;
    color: #111827;
    background: transparent;
}

QLabel#appSubtitle {
    font-size: 12px;
    color: #667085;
    background: transparent;
}

QWidget#topRegion {
    background-color: rgba(255, 255, 255, 240);
    border-bottom: 1px solid #cfd8e6;
}

QSplitter#mainSplit::handle {
    background-color: transparent;
    width: 10px;
}

QWidget#freeWorkspace {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop: 0 rgba(96, 165, 250, 90), stop: 0.5 rgba(56, 189, 248, 60),
        stop: 1 #dbeafe);
    margin: 10px;
}

QFrame#leftRail {
    background-color: rgba(255, 255, 255, 242);
    border: 1px solid #cbd5e1;
    border-radius: 16px;
}

QLabel#sectionTitle, QLabel#moduleTitle {
    font-size: 11px;
    font-weight: 800;
    color: #344054;
    background: transparent;
}

QLabel#moduleTitle {
    font-size: 12px;
}

QLabel#fileLabel, QLabel#workflowStepLabel, QLabel#fieldLabel {
    color: #344054;
    background: transparent;
}

QPushButton#workflowButton, QPushButton#workflowButtonCurrent,
QPushButton#workflowRunButton,
QPushButton#workflowMiniButton {
    background-color: white;
    border: 1px solid #c5d4e8;
    border-radius: 9px;
    padding: 6px 10px;
    color: #1e3a5f;
    font-weight: 600;
}

QPushButton#workflowButtonCurrent {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop: 0 #60a5fa, stop: 1 #2563eb);
    border: 1px solid #2563eb;
    color: white;
}

QPushButton#workflowRunButton {
    background-color: #2563eb;
    border: 1px solid #2563eb;
    color: white;
    font-weight: 800;
}

QPushButton#workflowButton:hover, QPushButton#workflowMiniButton:hover,
QPushButton#workflowButtonCurrent:hover, QPushButton#workflowRunButton:hover {
    border: 1px solid #2563eb;
    color: #1d4ed8;
}

QPushButton#workflowButtonCurrent:hover {
    color: white;
}


QPushButton#workflowRunButton:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
    color: white;
}

QPushButton#workflowButton:disabled, QPushButton#workflowButtonCurrent:disabled,
QPushButton#workflowRunButton:disabled,
QPushButton#workflowMiniButton:disabled {
    background-color: #eef2f7;
    border: 1px solid #dbe3ee;
    color: #9aa8b8;
}

QPushButton#workflowMiniButton {
    padding: 4px 8px;
    font-size: 12px;
}

QTabWidget::pane {
    background-color: rgba(255, 255, 255, 200);
    border: 1px solid #c5cfdd;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

QTabBar::tab {
    background-color: #eef5ff;
    border: 1px solid #c5d4e8;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 6px 14px;
    margin-right: 2px;
    color: #344054;
}

QTabBar::tab:selected {
    background-color: white;
    color: #1e3a5f;
    font-weight: 700;
}

QFrame#workflowStatusCard {
    background-color: #f8fbff;
    border: 1px solid #d5e1f0;
    border-radius: 12px;
}

QLabel#workflowStatusLabel {
    color: #1e3a5f;
    font-size: 12px;
    font-weight: 800;
    background: transparent;
}

QLabel#workflowElapsedLabel {
    color: #667085;
    font-size: 11px;
    font-family: monospace;
    background: transparent;
}

QProgressBar#workflowProgress {
    background-color: #dbe7f5;
    border: none;
    border-radius: 5px;
    height: 7px;
    text-align: center;
}

QProgressBar#workflowProgress::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop: 0 #60a5fa, stop: 1 #2563eb);
    border-radius: 5px;
}

QPushButton#workflowCancelButton {
    padding: 4px 9px;
    background-color: transparent;
    border: 1px solid #cbd5e1;
    color: #475467;
    font-size: 11px;
    border-radius: 6px;
}

QPushButton#workflowCancelButton:hover {
    background-color: #fff1f2;
    border: 1px solid #fda4af;
    color: #be123c;
}

QFrame#floatingCard {
    background-color: rgba(255, 255, 255, 250);
    border: 1px solid #c5d4e8;
    border-radius: 14px;
}

QPushButton#floatingCardCollapseButton {
    border: none;
    background: transparent;
    color: #344054;
    font-size: 15px;
    padding: 0;
}

QPushButton#floatingCardCollapseButton:hover {
    background: #e9eff8;
    border-radius: 5px;
}

QLabel#floatingCardTitle {
    font-size: 13px;
    font-weight: 800;
    color: #1e3a5f;
    background: transparent;
    padding: 2px;
}

QFrame#moduleCard {
    background-color: #f8fbff;
    border: 1px solid #d5e1f0;
    border-radius: 10px;
}

QLineEdit, QPlainTextEdit, QComboBox {
    background-color: white;
    border: 1px solid #c5d4e8;
    border-radius: 8px;
    padding: 5px 7px;
    selection-background-color: #2563eb;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QCheckBox {
    spacing: 7px;
    color: #344054;
    background: transparent;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 5px;
    border: 1px solid #b6c4d8;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop: 0 #60a5fa, stop: 1 #2563eb);
    border: 1px solid #2563eb;
}

QCheckBox:disabled {
    color: #9aa8b8;
}

QLabel#appHyperlink {
    background: transparent;
}

QTreeWidget, QListWidget {
    background-color: white;
    border: 1px solid #c5d4e8;
    border-radius: 8px;
    padding: 3px;
    outline: none;
}

QTreeWidget::item {
    min-height: 22px;
    padding: 3px 4px;
}

QTreeWidget::item:hover {
    background-color: #eef5ff;
    color: #1e3a5f;
}

QLabel#filtersStatusLabel {
    background-color: #eef5ff;
    border: 1px solid #bfdbfe;
    border-radius: 7px;
    color: #174ea6;
    font-weight: 700;
    padding: 5px 8px;
}

QTableWidget#sparqlResultsTable {
    background-color: white;
    alternate-background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    gridline-color: #e2e8f0;
    color: #1f2937;
    selection-background-color: #dbeafe;
    selection-color: #1e3a5f;
}

QTableWidget#validationResultsTable {
    background-color: white;
    alternate-background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    gridline-color: #e2e8f0;
    selection-background-color: rgba(37, 99, 235, 45);
    selection-color: #12355b;
}

QTableWidget#validationResultsTable::item {
    padding: 5px 6px;
}

QPlainTextEdit#validationDetails {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    color: #334155;
    padding: 6px;
}

QTableWidget#sparqlResultsTable::item {
    padding: 5px 7px;
    border: none;
}

QHeaderView::section {
    background-color: #eaf1fb;
    color: #1e3a5f;
    border: none;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
    padding: 6px 8px;
    font-weight: 700;
}

QPushButton#primaryButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop: 0 #60a5fa, stop: 1 #2563eb);
    color: white;
    border: 1px solid #2563eb;
    border-radius: 9px;
    padding: 6px 12px;
    font-weight: 700;
}

QPushButton#primaryButton:disabled {
    background-color: #cbd5e1;
    border-color: #cbd5e1;
    color: #f1f5f9;
}

QPushButton#secondaryButton {
    background-color: white;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    padding: 5px 12px;
    color: #475467;
}

QLabel#queryStatusLabel {
    font-size: 11px;
    color: #667085;
    background: transparent;
}

